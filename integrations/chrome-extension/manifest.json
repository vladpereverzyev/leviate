{
  "manifest_version": 3,
  "name": "Leviate - Hand control",
  "short_name": "Leviate",
  "version": "0.0.0",
  "description": "Move 3D models and the mouse in Chrome with your hand, with the webcam or your phone. Free and open source.",
  "homepage_url": "https://vladpereverzyev.github.io/leviate/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Leviate" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "debugger", "storage"],
  "commands": {
    "toggle-hand": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Turn the hand on or off"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
